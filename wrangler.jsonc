{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hafiz",
  "main": "dist/server/index.mjs",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "build": {
    "command": "bun run build"
  }
}
